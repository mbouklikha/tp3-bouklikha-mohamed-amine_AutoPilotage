{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "formatter": true,
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    }
  ]
}
