{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "formatter": true,
  "mcp": {
    "servers": {
      "autopilotage": {
        "type": "local",
        "command": [
          "node",
          "dist/src/mcp/server.js"
        ]
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    }
  ]
}
